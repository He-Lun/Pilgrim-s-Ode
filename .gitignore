# Unity generated / local
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/
*.csproj
*.sln
.vs/

# Ignore entire repository by default
/*

# Root files to track
!.gitignore
!README.md

# Only self-implemented C# under Assets/_Projects/Scripts/
!/Assets/
/Assets/*
!/Assets/_Projects/
/Assets/_Projects/*
!/Assets/_Projects/Scripts/

# Within Scripts: only .cs and .meta
/Assets/_Projects/Scripts/**/*
!/Assets/_Projects/Scripts/**/
!/Assets/_Projects/Scripts/**/*.cs
!/Assets/_Projects/Scripts/**/*.meta
